{
  "expo": {
    "name": "AlexFisher",
    "slug": "alexfisher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alexfisher",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b3d5c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexfisher.app"
    },
    "android": {
      "package": "com.alexfisher.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b3d5c",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b3d5c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
